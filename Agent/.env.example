# 系统配置
DEBUG=False
APP_ENV=development
# Docker Compose publishes this host port to the container's fixed port 5003.
PUBLIC_PORT=5003
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5003
COOKIE_SECURE=True
CACHE_BACKEND=memory
EMBEDDING_DEVICE=cpu

# 存储配置
# 默认 local：继续使用项目目录下的 uploads / knowledge_base / outputs。
# 外部 NAS 测试时，先把 NAS 共享目录挂载到应用服务器，再设置：
# STORAGE_BACKEND=nas
# NAS_MOUNT_PATH=/mnt/knowledge-agent
STORAGE_BACKEND=local
STORAGE_ROOT=
NAS_MOUNT_PATH=
UPLOADS_DIR=
KNOWLEDGE_BASE_DIR=
OUTPUTS_DIR=
KNOWLEDGE_SOURCE_DIR=
INGESTION_MANIFEST_DB=
SPREADSHEET_DB_PATH=
ADMIN_BACKUP_DIR=
REVIEW_PROPOSAL_TEMPLATE_PATH=

# LangGraph 持久化
# 环境配置仅支持 sqlite|postgres；单元测试通过依赖注入使用 InMemorySaver。
# 生产环境必须设置 APP_ENV=production、backend=postgres 和独立 DSN，
# 否则 graph_persistence 会拒绝启动，且不会静默降级。
CHAT_RUNTIME=langgraph
AGENT_ORCHESTRATOR=langgraph
LANGGRAPH_CHECKPOINTER_BACKEND=sqlite
LANGGRAPH_RUN_LEDGER_BACKEND=sqlite
LANGGRAPH_POSTGRES_DSN=
LANGGRAPH_SQLITE_PATH=./data/langgraph.sqlite
LANGGRAPH_DURABILITY=async
LANGGRAPH_STRICT_MSGPACK=true
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=90
LANGGRAPH_POOL_MIN_SIZE=1
LANGGRAPH_POOL_MAX_SIZE=2

# 组织结构（逗号分隔）；部署时按实际单位配置，不要写入公开源码。
DEPARTMENT_DIRS=综合管理部,人力资源部,财务部,运营保障部,市场部,业务部,客户服务部,项目部

# 管理员默认账号（首次启动时自动创建）
# 首次启动前必须设置强随机密码；不要提交真实值。
ADMIN_DEFAULT_PASSWORD=

# JWT 密钥（生产环境请生成随机字符串）
JWT_SECRET=generate-a-random-secret-here

# API密钥
DEEPSEEK_API_KEY=your-deepseek-api-key
BOCHA_API_KEY=sk-your-bocha-key-here
